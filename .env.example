# SEIM Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Mock Service Worker toggle (set to true to test offline or with realistic fixtures)
VITE_ENABLE_MOCKS=false

# Map Tile Configuration
VITE_TILE_LAYER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_LAYER_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Default Epicenter and Simulation Settings
VITE_DEFAULT_ORIGIN_LAT=12.98
VITE_DEFAULT_ORIGIN_LON=77.60
